<odoo>
    <record id="view_list_library_member" model="ir.ui.view">
		<field name="name">library.member.list.view</field>
		<field name="model">library.member</field>
		<field name="arch" type="xml">
			<list string="Library List">
					<field name="name"/>
					<field name="email"/>
                    <field name="is_active"/>
			</list>
		</field>
	</record>
     <record id="view_form_library_member" model="ir.ui.view">
		<field name="name">library.member.form.view</field>
		<field name="model">library.member</field>
		<field name="arch" type="xml">
			<form string="Library List">
                <group>
					<field name="name"/>
					<field name="email"/>
                    <field name="is_active"/>
                </group>
			</form>
		</field>
	</record>

    <record id="action_librarary_member" model="ir.actions.act_window">
        <field name="name">Library Member</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>

	 <menuitem id="menu_book_issue" name="Issue Book" parent="menu_library" action="action_book_issue" sequence="30"/>
	<menuitem id="menu_library_book" name="Books" parent="menu_library" action="action_library_book" sequence="20"/>
	<menuitem id="menu_library_member" name="Library Member" parent="menu_library" action="action_librarary_member" sequence="10"/>
</odoo>