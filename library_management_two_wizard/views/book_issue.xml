<odoo>

     <record id="view_form_book_issue" model="ir.ui.view">
		<field name="name">book.issue.form.view</field>
		<field name="model">book.issue</field>
		<field name="arch" type="xml">
			<form string="Customer Form">

                <header>
                    <field name="status" widget="statusbar"
                    statusbar_visible="draft,issue,returned"/>
                    <button name="action_issue"
                            type="object"
                            string="Confirm Issue"
                            class="btn-primary"
                            invisible="status != 'draft'"
							confirm="Are you sure you want to issue this book?"/>
                    <button name="action_return"
                            type="object"
                            string="Return Book"
                            class="btn-danger"
                            invisible="status != 'issue'"
							confirm="Are you sure you want to return this book?"/>

                </header>

                <!--<header>


                 <button name="action_return" type="object"
                        string="Return Book"
                        invisible="status != 'issue'"
                        class="btn-success"/>

                <button name="action_reset" type="object"
                        string="Reset"
                        invisible="[('status', '=', 'draft')]"/>


            </header> -->
                <sheet>
				<group>
					<field name="status" invisible="1"/>
					<field name="book_id" domain="[('available_qty','>',0)]"/>
					<field name="member_id"/>
                    <field name="issue_date" readonly="1"/>
                    <field name="return_date" invisible="1"/>

                    <field name="days_issued"/>
				</group>
                </sheet>
			</form>
		</field>
	</record>

	<record id="view_return_book_wizard_form" model="ir.ui.view">
    <field name="name">return.book.wizard.form</field>
    <field name="model">return.book.wizard</field>
    <field name="arch" type="xml">
        <form string="Return Book">
            <group>
                <field name="return_date" required="1"/>
                <button name="open_date_wizard"
                type="object"
                string="Set Date"
                class="btn-primary"/>

            </group>


            <footer>
                <button name="action_confirm_return"
                        type="object"
                        string="Return"
                        class="btn-primary"/>

                <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="view_date_wizard_form" model="ir.ui.view">
    <field name="name">date.wizard.form</field>
    <field name="model">date.wizard</field>
    <field name="arch" type="xml">
        <form string="Select Date">
            <group>
                <field name="selected_date"/>
            </group>
            <footer>
                <button name="action_apply_date"
                        string="Apply"
                        type="object"
                        class="btn-primary"/>
                <button string="Cancel" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
     <record id="view_list_book_issue" model="ir.ui.view">
		<field name="name">book.issue.list.view</field>
		<field name="model">book.issue</field>
		<field name="arch" type="xml">
			<list string="Library List">


					<field name="book_id"/>
					<field name="member_id"/>
                    <field name="issue_date"/>
                    <field name="return_date"/>
                    <field name="status"/>
                    <field name="days_issued"/>

			</list>
		</field>
	</record>

	<record id="action_book_issue" model="ir.actions.act_window">
        <field name="name">Book Issue</field>
        <field name="res_model">book.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library" name="Student Library"/>


</odoo>