<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lib_mgmt_member_tree" model="ir.ui.view">
        <field name="name">lib_mgmt.member.tree</field>
        <field name="model">lib_mgmt.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_lib_mgmt_member_form" model="ir.ui.view">
        <field name="name">lib_mgmt.member.form</field>
        <field name="model">lib_mgmt.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Member Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_lib_mgmt_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">lib_mgmt.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
