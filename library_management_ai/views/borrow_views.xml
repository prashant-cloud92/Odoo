<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lib_mgmt_borrow_tree" model="ir.ui.view">
        <field name="name">lib_mgmt.borrow.tree</field>
        <field name="model">lib_mgmt.borrow</field>
        <field name="arch" type="xml">
            <list string="Borrowings">
                <field name="name"/>
                <field name="book_id"/>
                <field name="member_id"/>
                <field name="borrow_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'borrowed'" decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_lib_mgmt_borrow_form" model="ir.ui.view">
        <field name="name">lib_mgmt.borrow.form</field>
        <field name="model">lib_mgmt.borrow</field>
        <field name="arch" type="xml">
            <form string="Borrowing">
                <header>
                    <button name="action_borrow" string="Borrow" type="object" class="oe_highlight" invisible="state != 'draft'" groups="library_management_ai.group_library_admin"/>
                    <button name="action_return" string="Return" type="object" class="oe_highlight" invisible="state != 'borrowed'" groups="library_management_ai.group_library_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,borrowed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="book_id" readonly="state != 'draft'"/>
                            <field name="member_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="borrow_date" readonly="state != 'draft'"/>
                            <field name="return_date" readonly="state != 'draft'"/>
                            <field name="actual_return_date" readonly="1" invisible="state not in ('returned', 'lost')"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_lib_mgmt_borrow" model="ir.actions.act_window">
        <field name="name">Borrowings</field>
        <field name="res_model">lib_mgmt.borrow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
