<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categories -->
    <record id="module_category_library" model="ir.module.category">
        <field name="name">Library</field>
        <field name="description">Helps you manage your library.</field>
        <field name="sequence">10</field>
    </record>

    <!-- Groups -->
    <record id="group_library_user" model="res.groups">
        <field name="name">Member (User)</field>
        <field name="category_id" ref="module_category_library"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_library_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_library"/>
        <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="borrow_rule_user" model="ir.rule">
        <field name="name">User can only see their own borrows</field>
        <field name="model_id" ref="model_lib_mgmt_borrow"/>
        <field name="groups" eval="[(4, ref('group_library_user'))]"/>
        <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
    </record>

    <record id="borrow_rule_admin" model="ir.rule">
        <field name="name">Admin can see all borrows</field>
        <field name="model_id" ref="model_lib_mgmt_borrow"/>
        <field name="groups" eval="[(4, ref('group_library_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="member_rule_user" model="ir.rule">
        <field name="name">User can only see their own member record</field>
        <field name="model_id" ref="model_lib_mgmt_member"/>
        <field name="groups" eval="[(4, ref('group_library_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="member_rule_admin" model="ir.rule">
        <field name="name">Admin can see all members</field>
        <field name="model_id" ref="model_lib_mgmt_member"/>
        <field name="groups" eval="[(4, ref('group_library_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
