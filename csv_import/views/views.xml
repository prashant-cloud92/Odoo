<odoo>


    <record model="ir.ui.view" id="csv_import_list">
      <field name="name">csv.form</field>
      <field name="model">student.import</field>
      <field name="arch" type="xml">
        <form>
            <field name="file"/>
            <field name="file_name"/>
            <button name="action_import_csv"
        string="Import"
        type="object"
        class="btn-primary"/>
                  </form>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="csv_import_button">
      <field name="name">csv.import.window</field>
      <field name="res_model">student.import</field>
      <field name="view_mode">form</field>
    </record>


