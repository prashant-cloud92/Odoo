<odoo>
    <record id="form_view_student_detail" model="ir.ui.view">
        <field name="name">form.view.student.detail</field>
        <field name="model">student.info</field>
        <field name="arch" type="xml">
            <form string="Student Info Form">
				<group>
					<field name="name"/>
                    <field name="email"/>
                    <field name="address"/>
                    <field name="mobile"/>
                    <field name="gender"/>
                    <field name="birth_date"/>
                    <field name="interest_subject" widget="many2many_tags"/>
				</group>
			</form>
        </field>
    </record>

     <record id="list_view_student_detail" model="ir.ui.view">
		<field name="name">list.view.student.detail</field>
		<field name="model">student.info</field>
		<field name="arch" type="xml">
			<list string="Student Info List">
				<field name="name"/>
                    <field name="email"/>
                    <field name="address"/>
                    <field name="mobile"/>
                    <field name="interest_subject" widget="many2many_tags"/>

			</list>
		</field>
	</record>
    <record id="action_student_info" model="ir.actions.act_window">
        <field name="name">Student Info</field>
        <field name="res_model">student.info</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_student_inter" model="ir.actions.act_window">
        <field name="name">Student Interest</field>
        <field name="res_model">interest.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_main" name="Library Management"/>
    <menuitem id="menu_student_list" name="Student Info" parent="menu_student_main" action="action_student_info" sequence="10"/>
    <menuitem id="menu_student_interest" name="Student Interest" parent="menu_student_main" action="action_student_inter" sequence="20"/>
</odoo>