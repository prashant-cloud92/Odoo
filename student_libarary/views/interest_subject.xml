<odoo>
    <record id="view_student_interest_subject" model="ir.ui.view">
        <field name="name">view.form.student.interest.subject</field>
        <field name="model">interest.subject</field>
        <field name="arch" type="xml">
            <form string="Student Interest Form">
				<group>
					<field name="interest_subject"/>
					<field name="student_id" widget="many2many_tags"/>

				</group>
			</form>
        </field>
    </record>

     <record id="view_student_info_list_view" model="ir.ui.view">
		<field name="name">view.list.student.interest.subject</field>
		<field name="model">interest.subject</field>
		<field name="arch" type="xml">
			<list string="Student Interest List">
				<field name="interest_subject"/>
				<field name="student_id" widget="many2many_tags"/>

			</list>
		</field>
	</record>

</odoo>