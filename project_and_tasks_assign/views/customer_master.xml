<odoo>
	<!-- ===========bank view========== -->
    <record id="view_customer_master_form" model="ir.ui.view">
        <field name="name">customer.master.form.view</field>
        <field name="model">customer.master</field>
        <field name="arch" type="xml">
            <form>
				<group>
					<field name="name"/>
					<field name="company_name"/>
					<field name="city"/>
					<field name="mobile"/>
					<field name="email"/>
				</group>
			</form>
        </field>
    </record>
    <record id="view_customer_master_list" model="ir.ui.view">
        <field name="name">customer.master.list.view</field>
        <field name="model">customer.master</field>
        <field name="arch" type="xml">
            <list>
					<field name="name"/>
					<field name="company_name"/>
					<field name="city"/>
					<field name="mobile"/>
					<field name="email"/>
			</list>
        </field>
    </record>
    <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">customer.master</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_project_main"
          name="Project And Task"
          action="action_customer"/>
    <menuitem id="submenu_customer"
          name="Customer"
          parent="menu_project_main"
          action="action_customer"
          sequence="10"/>
</odoo>