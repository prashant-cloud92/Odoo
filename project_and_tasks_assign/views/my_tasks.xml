<odoo>
	<!-- ===========bank view========== -->
    <record id="view_my_task_form" model="ir.ui.view">
        <field name="name">view.my.task.form</field>
        <field name="model">my.task</field>
        <field name="arch" type="xml">
            <form>
				<group>
					<field name="task_name"/>
					<field name="project_id"/>
					<field name="assigned_to_id" domain="[('id','in',project_member_id)]"/>
					<field name="priority" widget="radio"/>
					<field name="estimated_hours"/>
                    <field name="status" widget="radio"/>
				</group>
			</form>
        </field>
    </record>
    <record id="view_my_task_list" model="ir.ui.view">
        <field name="name">view.my.task.list</field>
        <field name="model">my.task</field>
        <field name="arch" type="xml">
            <list>
					<field name="task_name"/>
					<field name="project_id"/>
					<field name="assigned_to_id"/>
					<field name="priority"/>
					<field name="estimated_hours"/>
                    <field name="status"/>
			</list>
        </field>
    </record>

     <record id="action_my_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">my.task</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="my_task_menu"
          name="Task"
          parent="menu_project_main"
          action="action_my_task"
          sequence="30"/>
</odoo>