<odoo>
	<!-- ===========bank view========== -->
    <record id="view_project_master_form" model="ir.ui.view">
        <field name="name">project.master.form.view</field>
        <field name="model">my.project</field>
        <field name="arch" type="xml">
            <form>
				<group>


					<field name="name"/>
					<field name="customer_id"/>
					<field name="budget"/>
					<field name="is_active"/>
					<field name="task_ids"/>
                    <field name="member_ids" widget="Many2many_tags"/>

				</group>
			</form>
        </field>
    </record>

    <record id="view_project_master_list" model="ir.ui.view">
        <field name="name">project.master.list.view</field>
        <field name="model">my.project</field>
        <field name="arch" type="xml">
            <list>


					<field name="name"/>
					<field name="customer_id"/>
					<field name="budget"/>
					<field name="is_active"/>
					<field name="task_ids"/>
                    <field name="member_ids" widget="Many2many_tags"/>


			</list>
        </field>
    </record>
     <record id="action_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">my.project</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="submenu_projects"
          name="Projects"
          parent="menu_project_main"
          action="action_project"
          sequence="20"/>


</odoo>