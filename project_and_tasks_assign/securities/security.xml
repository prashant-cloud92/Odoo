<odoo>
    <record id="project_access_user" model="res.groups">
        <field name="name">project user</field>
    </record>

    <record id="project_manager_access_full" model="res.groups">
        <field name="name">project full access</field>
        <field name="implied_ids" eval="[(4,ref('project_access_user'))]"/>
    </record>

     <record id="my_model_record_rule" model="ir.rule">
            <field name="name">My Model Manager Rule</field>
            <field name="model_id" ref="model_my_task"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('project_manager_access_full'))]"/>
        </record>

</odoo>