<odoo>

    <record id="city_form" model="ir.ui.view">
		<field name="name">city.form</field>
		<field name="model">city.detail</field>
		<field name="arch" type="xml">
			<form string="City Form">
				<group>
					<field name="city_name"/>

					<field name="country_name" widget="many2many_tags"/>

				</group>
			</form>
		</field>
	</record>

    <record id="_list_city_list" model="ir.ui.view">
		<field name="name">city.list</field>
		<field name="model">city.detail</field>
		<field name="arch" type="xml">
			<list string="City List">

					<field name="city_name"/>

					<field name="country_name" widget="many2many_tags"/>


			</list>
		</field>
	</record>



    <record id="country_form" model="ir.ui.view">
		<field name="name">country.form</field>
		<field name="model">country.detail</field>
		<field name="arch" type="xml">
			<form string="Country Form">
				<group>
					<field name="country_name"/>



				</group>
			</form>
		</field>
	</record>

    <record id="list_country_list" model="ir.ui.view">
		<field name="name">country.list</field>
		<field name="model">country.detail</field>
		<field name="arch" type="xml">
			<list string="Country List">

					<field name="country_name"/>




			</list>
		</field>
	</record>


<record id="country_action" model="ir.actions.act_window">
        <field name="name">Country</field>
        <field name="res_model">country.detail</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="city_action" model="ir.actions.act_window">
        <field name="name">City</field>
        <field name="res_model">city.detail</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_model_main" name="Country City Demo"/>
    <menuitem id="menu_bank_acc_list" name="Country" parent="menu_model_main" action="country_action" sequence="10"/>
	<menuitem id="menu_customer_acc_list" name="City" parent="menu_model_main" action="city_action" sequence="20"/>

</odoo>