<odoo>
	<!-- ===========bank view========== -->
    <record id="view_student_info" model="ir.ui.view">
        <field name="name">view.student.info</field>
        <field name="model">student.detail</field>
        <field name="arch" type="xml">
            <form string="Student Form">
                <sheet>
                    <group>
                        <group>

                            <field name="first_name" required="1"/>
                            <field name="last_name" required="1"/>
                            <field name="surname" required="1"/>
                        </group>
                        <group>
                            <field name="birth_date" required="1"/>
                            <field name="email" required="1"/>
                            <field name="mobile" required="1"/>
                        </group>
                     </group>

                </sheet>
			</form>
        </field>
    </record>

     <record id="list_student_info" model="ir.ui.view">
        <field name="name">list.student.info</field>
        <field name="model">student.detail</field>
        <field name="arch" type="xml">
            <list string="Student Form">


					<field name="first_name"/>
					<field name="last_name"/>
					<field name="surname"/>
					<field name="birth_date"/>
					<field name="email"/>
					<field name="mobile"/>



			</list>
        </field>
    </record>

   <record id="action_student_info" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="res_model">student.detail</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_main" name="Student Manager"/>
    <menuitem id="menu_student_detail" name="Students" parent="menu_student_main" action="action_student_info" sequence="10"/>

</odoo>