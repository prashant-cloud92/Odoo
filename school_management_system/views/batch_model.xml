<odoo>
    <record id="view_school_batch_line_tree" model="ir.ui.view">
    <field name="name">school.batch.line.tree</field>
    <field name="model">batch.model</field>
    <field name="arch" type="xml">
        <list>
            <field name="student_id"/>
            <field name="subject_id"/>
        </list>
    </field>
</record>

<!-- ============================= -->
<!-- BATCH LINE FORM VIEW -->
<!-- ============================= -->
<record id="view_school_batch_line_form" model="ir.ui.view">
    <field name="name">school.batch.line.form</field>
    <field name="model">batch.model</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="student_id"/>
                    <field name="subject_id"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- ACTION -->
<record id="action_school_batch_line" model="ir.actions.act_window">
    <field name="name">Batch Lines</field>
    <field name="res_model">batch.model</field>
    <field name="view_mode">list,form</field>
</record>
 <menuitem id="menu_school_main"
              name="School"/>
<!-- MENU -->
<menuitem id="menu_school_batch_line"
          name="Batch Lines"
          parent="menu_school_main"
          action="action_school_batch_line"
          sequence="4"/>
</odoo>