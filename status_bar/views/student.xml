<odoo>
<record id="view_student_form" model="ir.ui.view">
    <field name="name">student.admission.form</field>
    <field name="model">student.admission</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <field name="state" widget="statusbar"
                    statusbar_visible="draft,submitted,approved,rejected"/>

                <button name="action_submit" type="object"
                        string="Submit" invisible="state != 'draft'" class="btn-primary"/>
                <button name="action_approve" type="object"
                        string="Approve" invisible="state != 'submitted'" class="btn-success"/>
                <button name="action_reject" type="object"
                        string="Reject" invisible="state != 'submitted'" class="btn-danger"/>
                <button name="action_reset" type="object"
                        string="Reset" invisible="state not in ('approved','rejected')"/>
            </header>

            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>

        </form>
    </field>
    </record>

    <record id="action_student_admission" model="ir.actions.act_window">
    <field name="name">Admissions</field>
    <field name="res_model">student.admission</field>
    <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_root" name="Student"/>

<menuitem id="menu_student_admission"
          name="Admissions"
          parent="menu_student_root"
          action="action_student_admission"/>


</odoo>