<odoo>
<record id="view_employee_form" model="ir.ui.view">
    <field name="name">employee.form</field>
    <field name="model">company.employee</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="emp_id"/>
                    <field name="personal_id"/>
                    <field name="department"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <record id="view_employee_list" model="ir.ui.view">
    <field name="name">employee.list</field>
    <field name="model">company.employee</field>
    <field name="arch" type="xml">
        <list>

                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="emp_id"/>
            <field name="personal_id"/>
                    <field name="department"/>

        </list>
    </field>
</record>

     <record id="action_emp" model="ir.actions.act_window">
        <field name="name">Customer Tag</field>
        <field name="res_model">company.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_employee" name="Employee Inherits Demo"/>
    <menuitem id="submenu_emp" name="Employee" parent="menu_employee" action="action_emp" sequence="10"/>
    </odoo>