<odoo>

    <record id="view_form_account_transaction" model="ir.ui.view">
		<field name="name">view.form.account.transaction</field>
		<field name="model">account.transaction</field>
		<field name="arch" type="xml">
			<form string="Transaction Form">
				<group>
					<field name="bank_account_id" required="1"/>
					<field name="customer_ids" required="1" invisible="1"/>

					<field name="customer_id" required="1" domain="[('id','=',customer_ids)]"/>
					<field name="amount" required="1"/>
                    <field name="date" required="1"/>
                    <field name="transaction_type" required="1"/>

				</group>
			</form>
		</field>
	</record>

    <record id="view_list_account_transaction" model="ir.ui.view">
		<field name="name">view.list.account.transaction</field>
		<field name="model">account.transaction</field>
		<field name="arch" type="xml">
			<list string="Transaction List">

					<field name="bank_account_id"/>
					<field name="customer_id"/>
					<field name="amount" />
                    <field name="date"/>
                    <field name="transaction_type" />


			</list>
		</field>
	</record>

	<record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Account Transaction</field>
        <field name="res_model">account.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>