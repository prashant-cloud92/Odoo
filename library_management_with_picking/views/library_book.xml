<odoo>
     <record id="view_form_library_book" model="ir.ui.view">
		<field name="name">library.book.form.view</field>
		<field name="model">library.book</field>
		<field name="arch" type="xml">
			<form string="Library List">
                <sheet>

                    <div class="oe_button_box" name="button_box">



            <button type="object" name="action_open_documents"
                    class="oe_stat_button" icon="fa-file-text">
                <field name="issue_book_count" widget="statinfo" string="Book Issuer"/>
            </button>



        </div>
                <group>
					<field name="name"/>
					<field name="author_name"/>
                    <field name="available_qty"/>
                    <field name="is_available"/>
					<field name="code"/>
                </group>
                </sheet>
			</form>
		</field>
	</record>

	<record id="view_book_search" model="ir.ui.view">
		<field name="name">library.book.search</field>
		<field name="model">library.book</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="code"/>
			<separator/>

			<filter name="available_filter"
        string="Available"
        domain="[('is_available','=',True)]"/>
			</search>
		</field>

	</record>

      <record id="view_list_library_book" model="ir.ui.view">
		<field name="name">library.book.list.view</field>
		<field name="model">library.book</field>
		<field name="arch" type="xml">
			<list string="Library List">

					<field name="name"/>
					<field name="author_name"/>
                    <field name="available_qty"/>
                    <field name="is_available"/>
				<field name="code"/>

			</list>
		</field>
	</record>

<record id="view_book_kanban" model="ir.ui.view">
    <field name="name">library.book.kanban</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
        <kanban>
			<field name="is_available"/>
			<field name="available_qty"/>
            <templates>
                <t t-name="kanban-box">

                    <div class="oe_kanban_card">

                        <!-- Book Code + Name -->
                        <strong>
                            <field name="name"/>
                        </strong>

                        <div>
                            <b>Author:</b> <field name="author_name"/>
                        </div>

                        <div t-attf-class="oe_kanban_card #{record.available_qty.raw_value == 0 and 'text-danger' or ''}">
                            <b>Qty:</b> <field name="available_qty"/>
                        </div>

                        <div>

                            <b>Status:</b>
                            <span t-if="record.is_available.raw_value">Available</span>
                            <span t-else="">Not Available</span>
                        </div>

                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Book</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,kanban,form</field>
		<field name="search_view_id" ref="view_book_search"/>
    </record>

	<menuitem id="library_books" name="Books" parent="menu_library" action="action_library_book" sequence="10"/>
	<menuitem id="book_issue" name="Issue Book" parent="menu_library" action="action_book_issue" sequence="20"/>
</odoo>