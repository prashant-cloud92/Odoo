<odoo>

     <record id="view_form_book_issue" model="ir.ui.view">
		<field name="name">book.issue.form.view</field>
		<field name="model">book.issue</field>
		<field name="arch" type="xml">
			<form string="Book Issue">

                <header>
                    <field name="status" widget="statusbar"
                    statusbar_visible="draft,issue,returned"/>
                    <button name="action_issue"
                            type="object"
                            string="Confirm Issue"
                            class="btn-primary"
                            invisible="status != 'draft'"
							confirm="Are you sure you want to issue this book?"/>
                    <button name="action_return"
                            type="object"
                            string="Return Book"
                            class="btn-danger"
                            invisible="status != 'issue'"
							confirm="Are you sure you want to return this book?"/>

                </header>

                <!--<header>


                 <button name="action_return" type="object"
                        string="Return Book"
                        invisible="status != 'issue'"
                        class="btn-success"/>

                <button name="action_reset" type="object"
                        string="Reset"
                        invisible="[('status', '=', 'draft')]"/>


            </header> domain="[('available_qty','>',0)]"-->
                <sheet>
                    <div class="oe_title">
                                <h1>
                                    <field name="sequence_gen" readonly="1"/>
                                </h1>
                            </div>
                    <group>

                        <!-- <field name="status" invisible="1"/> -->

                        <group>


                        <field name="book_id" widget="many2many_tags"/>
                        <field name="member_id" />
                        <field name="issue_date" readonly="1" widget="date"/>

                            </group>

                       <!--  <group>
                       <div class="d-flex align-items-center">
                            <field name="return_date" class="oe_inline" style="width:auto;" widget="date" readonly="1" invisible="status != 'issue'"/>
                            <button name="open_calender_field"
                                    groups="library_management.librarian_admin_master"
                                    invisible="status != 'issue'"

                                type="object"
                                string="Set Date"
                                class="btn btn-success ms-2"/>
                        </div>
                        </group>

                        <group>
                            <field name="last_date"/>
                            <field name="total_penalty" invisible="status != 'returned'" class="text-danger"/>
                            <field name="days_issued" invisible="status != 'issue'"/>
                        </group>
                        -->
				</group>
                </sheet>
			</form>
		</field>
	</record>

	<record id="view_return_book_wizard_form" model="ir.ui.view">
    <field name="name">date.wizard.form</field>
    <field name="model">date.wizard</field>
    <field name="arch" type="xml">
        <form string="Return Book">
            <group>
                <field name="return_date" widget="date" required="1"/>


            </group>


            <footer>
                <button name="action_confirm_return"
                        type="object"
                        string="Return"
                        class="btn-primary"/>

                <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>


     <record id="view_list_book_issue" model="ir.ui.view">
		<field name="name">book.issue.list.view</field>
		<field name="model">book.issue</field>
		<field name="arch" type="xml">
			<list string="Library List">

                    <field name="sequence_gen"/>
					<field name="book_id"/>
					<field name="member_id"/>
                    <field name="issue_date"/>
                    <field name="return_date"/>

                    <field name="status"/>
                    <field name="last_date"/>
                    <field name="days_issued"/>

			</list>
		</field>
	</record>

    <record id="view_my_wizard_form" model="ir.ui.view">
    <field name="name">my.wizard.form.new</field>
    <field name="model">my.wizard.return</field>
    <field name="arch" type="xml">
        <form string="My Wizard">
            <group>
                <field name="main_id"/>
            </group>

            <field name="line_ids">
                <list editable="bottom">
                    <field name="selected"/>
                    <field name="product_id"/>
                    <field name="qty"/>
                </list>
            </field>

            <footer>
                <button name="action_return_picking"
                        type="object"
                        string="Return"
                        class="btn-primary"/>

                <button string="Cancel"
                        special="cancel"/>
            </footer>
        </form>
    </field>
</record>

	<record id="action_book_issue" model="ir.actions.act_window">
        <field name="name">Book Issue</field>
        <field name="res_model">book.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library" name="Student Library 3.0"/>


</odoo>