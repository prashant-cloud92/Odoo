<odoo>
    <record id="librarian_access_user" model="res.groups">
        <field name="name">librarian</field>
    </record>

    <record id="librarian_admin" model="res.groups">
        <field name="name">librarian admin full access</field>
        <field name="implied_ids" eval="[(4,ref('librarian_access_user'))]"/>
    </record>

    <record id="librarian_admin_master" model="res.groups">
        <field name="name">librarian admin master full access</field>
        <field name="implied_ids" eval="[(4,ref('librarian_admin'))]"/>
    </record>


    <record id="rule_issue_book_own" model="ir.rule">
    <field name="name">Own book only</field>
    <field name="model_id" ref="model_book_issue"/>
    <field name="groups" eval="[(4, ref('library_management.librarian_access_user'))]"/>
    <field name="domain_force">[('member_id', '=', user.id)]</field>
    </record>

    <record id="rule_admin_group" model="ir.rule">
    <field name="name">admin group</field>
    <field name="model_id" ref="model_book_issue"/>
    <field name="groups" eval="[(4, ref('library_management.librarian_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    </record>



</odoo>