<odoo>

    <record id="view_form_product_sale" model="ir.ui.view">
		<field name="name">view.form.sale.line</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//list/field[@name='price_unit']" position="before">




					<field name="shutter_width"/>

					<field name="shutter_height"/>
					<field name="lock_product_id"/>
					<field name="stopper_product_id"/>
					<field name="blade_product_id"/>







			</xpath>
		</field>
	</record>
</odoo>