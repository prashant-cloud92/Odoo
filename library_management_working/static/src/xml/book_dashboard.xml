<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="library_management_working.BookDashboard">

        <div class="container mt-4">

            <div class="row">

                <div class="col-4">
                    <div class="card">
                        <div class="card-body">
                            <h3>Total Books</h3>
                            <h1>
                                <t t-esc="state.total_books"/>
                            </h1>
                        </div>
                    </div>
                </div>


                <div class="col-4">
                    <div class="card">
                        <div class="card-body">
                            <h3>Available Books</h3>
                            <h1>
                                <t t-esc="state.available_books"/>
                            </h1>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>