<odoo>
     <record id="view_form_book" model="ir.ui.view">
		<field name="name">library.book.view</field>
		<field name="model">book.detail</field>
		<field name="arch" type="xml">
			<form string="Library List">
                <sheet>

                    <group>
					<field name="name"/>
					<field name="author_name"/>
                    <field name="available_qty"/>
                    <field name="is_available"/>

                    </group>

                </sheet>
                <chatter/>
			</form>

		</field>
	</record>

	<record id="view_book_search" model="ir.ui.view">
		<field name="name">library.book.search</field>
		<field name="model">book.detail</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>

			<separator/>

			<filter name="available_filter"
        string="Available"
        domain="[('is_available','=',True)]"/>
			</search>
		</field>

	</record>

      <record id="book_list_view" model="ir.ui.view">
		<field name="name">book.list.view</field>
		<field name="model">book.detail</field>
		<field name="arch" type="xml">
			<list string="Library List">

					<field name="name"/>
					<field name="author_name"/>
                    <field name="available_qty"/>
                    <field name="is_available"/>


			</list>
		</field>
	</record>

<record id="view_book_kanban" model="ir.ui.view">
    <field name="name">library.book.kanban</field>
    <field name="model">book.detail</field>
    <field name="arch" type="xml">
        <kanban>
			<field name="is_available"/>
			<field name="available_qty"/>
            <templates>
                <t t-name="kanban-box">

                    <div class="oe_kanban_card">

                        <!-- Book Code + Name -->
                        <strong>
                            <field name="name"/>
                        </strong>

                        <div>
                            <b>Author:</b> <field name="author_name"/>
                        </div>

                        <div t-attf-class="oe_kanban_card #{record.available_qty.raw_value == 0 and 'text-danger' or ''}">
                            <b>Qty:</b> <field name="available_qty"/>
                        </div>

                        <div>

                            <b>Status:</b>
                            <span t-if="record.is_available.raw_value">Available</span>
                            <span t-else="">Not Available</span>
                        </div>

                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Book</field>
        <field name="res_model">book.detail</field>
        <field name="view_mode">list,kanban,form</field>
		<field name="search_view_id" ref="view_book_search"/>
    </record>
    <menuitem id="menu_library" name="Student Library 5.0"/>
	<menuitem id="library_books" name="Books" parent="menu_library" action="action_library_book" sequence="10"/>

</odoo>