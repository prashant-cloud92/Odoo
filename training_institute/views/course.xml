<odoo>



	<!-- ===========Course Form view========== -->
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">course.form.view</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form string="Student Form">
				<group>
                    <group>
                        <field name="name"/>
                        <field name="fees"/>
                        <field name="duration_days"/>
                    </group>
                    <group>
                        <field name="is_active"/>
                        <field name="level"/>
                    </group>
                    <group>
                        <field name="student_ids" widget="many2many_tags"/>
                        <field name="batch_ids" widget="many2many_tags"/>
				    </group>
				</group>
			</form>
        </field>
    </record>

    <!-- ===========Course List view========== -->
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">course.list.view</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <list string="Course Record">
                     <field name="name"/>
                        <field name="fees"/>
                        <field name="duration_days"/>
                        <field name="is_active"/>
                        <field name="level"/>
                        <field name="student_ids" widget="many2many_tags"/>
                        <field name="batch_ids" widget="many2many_tags"/>
			</list>
        </field>
    </record>
</odoo>