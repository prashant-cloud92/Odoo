<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billboard_board_form" model="ir.ui.view">
        <field name="name">billboard.board.form</field>
        <field name="model">billboard.board</field>
        <field name="arch" type="xml">
            <form string="Billboard">
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Billboard at Times Square"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id"/>
                            <field name="location"/>
                            <field name="price"/>
                        </group>
                    </group>
                    <group string="Custom Properties">
                        <field name="properties" nolabel="1" widget="properties"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_billboard_board_tree" model="ir.ui.view">
        <field name="name">billboard.board.tree</field>
        <field name="model">billboard.board</field>
        <field name="arch" type="xml">
            <list string="Billboards">
                <field name="name"/>
                <field name="type_id"/>
                <field name="location"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="action_billboard_board" model="ir.actions.act_window">
        <field name="name">Billboards</field>
        <field name="res_model">billboard.board</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
