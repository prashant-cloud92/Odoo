<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billboard_type_form" model="ir.ui.view">
        <field name="name">billboard.type.form</field>
        <field name="model">billboard.type</field>
        <field name="arch" type="xml">
            <form string="Billboard Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Black Board"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="property_definitions" widget="properties_definition"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_billboard_type_tree" model="ir.ui.view">
        <field name="name">billboard.type.tree</field>
        <field name="model">billboard.type</field>
        <field name="arch" type="xml">
            <list string="Billboard Types">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_billboard_type" model="ir.actions.act_window">
        <field name="name">Billboard Types</field>
        <field name="res_model">billboard.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
